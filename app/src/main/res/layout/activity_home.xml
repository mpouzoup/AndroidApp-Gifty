<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/mainConstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131316"
    tools:context=".ui.HomeActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="12dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvHello"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, Gifty User!"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E2E8F0" /> <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Ready to discover the perfect gift? "
                android:textSize="14sp"
                android:textColor="#64748B"
                android:fontFamily="sans-serif" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gridActionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/headerLayout">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFindGift"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#8B5CF6" android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gift Finder"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Find smart AI suggestions instantly"
                                android:textSize="13sp"
                                android:textColor="#DDD6FE" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="#A78BFA">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_search"
                                app:tint="#FFFFFF" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWishlist"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#251E35"
                    app:cardBackgroundColor="#1E1E24" android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:id="@+id/ivWishlistIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#A78BFA" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/ivWishlistIcon"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Wishlist"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="View Saved"
                            android:textColor="#8B5CF6"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeCalendar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#1E1E24"
                app:layout_constraintTop_toBottomOf="@id/gridActionsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_alignParentStart="true"
                            android:text="Upcoming Events"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/tvViewAllReminders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:text="View All →"
                            android:textColor="#8B5CF6"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground" />
                    </RelativeLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:id="@+id/layoutTimelineDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:padding="4dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/dayMon"
                                android:layout_width="60dp"
                                android:layout_height="85dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp"
                                app:cardBackgroundColor="#8B5CF6">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MON" android:textSize="11sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:layout_marginTop="2dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/dayTue"
                                android:layout_width="60dp"
                                android:layout_height="85dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="2dp"
                                app:strokeColor="#8B5CF6"
                                app:cardBackgroundColor="#131316">
                                <FrameLayout
                                    android:id="@+id/borderTue"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="2dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical"
                                        android:gravity="center">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUE" android:textSize="11sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-medium"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="26" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
                                    </LinearLayout>
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/dayWed"
                                android:layout_width="60dp"
                                android:layout_height="85dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#2D2D35"
                                app:cardBackgroundColor="#131316">
                                <FrameLayout
                                    android:id="@+id/borderWed"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="2dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical"
                                        android:gravity="center">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WED" android:textSize="11sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-medium"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
                                    </LinearLayout>
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/dayThu"
                                android:layout_width="60dp"
                                android:layout_height="85dp"
                                android:layout_marginEnd="10dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#2D2D35"
                                app:cardBackgroundColor="#131316">
                                <FrameLayout
                                    android:id="@+id/borderThu"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="2dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical"
                                        android:gravity="center">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THU" android:textSize="11sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-medium"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
                                    </LinearLayout>
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/dayFri"
                                android:layout_width="60dp"
                                android:layout_height="85dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#2D2D35"
                                app:cardBackgroundColor="#131316">
                                <FrameLayout
                                    android:id="@+id/borderFri"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="2dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:orientation="vertical"
                                        android:gravity="center">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FRI" android:textSize="11sp" android:textColor="#94A3B8" android:fontFamily="sans-serif-medium"/>
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="29" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
                                    </LinearLayout>
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </HorizontalScrollView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutNextEvent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#131316">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_lock_idle_alarm"
                                app:tint="#8B5CF6" />

                            <TextView
                                android:id="@+id/tvNextEventText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="No upcoming events this week"
                                android:textSize="14sp"
                                android:textColor="#E2E8F0"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>