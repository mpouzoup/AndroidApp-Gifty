<?xml version="1.0" encoding="utf-8"?>

<!-- Main root layout for the Reminders screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131316">

    <!-- Header section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="64dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBackToHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_ios_24"
            app:tint="#8B5CF6"
            android:contentDescription="Back to Home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvRemindersTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Reminders"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            app:layout_constraintStart_toEndOf="@id/btnBackToHome"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Never miss a special day ✨"
            android:textColor="#64748B"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="@id/tvRemindersTitle"
            app:layout_constraintTop_toBottomOf="@id/tvRemindersTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- Main content container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="100dp">

            <!-- Calendar card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#1E1E24"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#11FFFFFF"
                app:strokeWidth="1dp">

                <!-- Calendar date picker -->
                <DatePicker
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:datePickerMode="calendar"
                    android:calendarViewShown="true"
                    android:spinnersShown="false"
                    android:background="#1E1E24"
                    android:theme="@style/CustomDatePickerTheme" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming events section title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Upcoming Events"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <!-- Container holding reminders RecyclerView -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvEventsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E1E24"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#11FFFFFF"
                app:strokeWidth="1dp"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/list_item_reminder" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Layout shown when there are no reminders -->
            <LinearLayout
                android:id="@+id/emptyRemindersLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="40dp"
                android:paddingHorizontal="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#3F3F46"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No celebrations ahead"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#94A3B8"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tap the button below to add your first gift alert!"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:textAlignment="center" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating action button for adding reminders -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Add Reminder"
        android:backgroundTint="#8B5CF6"
        app:backgroundTint="#8B5CF6"
        app:fabSize="normal"
        app:tint="@color/white"
        app:srcCompat="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:borderWidth="0dp"
        app:elevation="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>