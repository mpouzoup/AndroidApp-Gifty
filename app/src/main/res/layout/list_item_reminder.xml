<?xml version="1.0" encoding="utf-8"?>

<!-- Card layout for a reminder item -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvReminderCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#1E1E24">

    <!-- FrameLayout used for swipe-to-delete effect -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background layout shown during swipe delete -->
        <LinearLayout
            android:id="@+id/backLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EF4444" android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#FFFFFF"
                android:contentDescription="Delete Action" />
        </LinearLayout>

        <!-- Foreground reminder content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/frontLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#a988f5"
            android:padding="18dp">

            <!-- Reminder event name -->
            <TextView
                android:id="@+id/tvReminderEvent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Event Name Placeholder"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#4c1d95"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvReminderDate"
                android:layout_marginEnd="12dp" />

            <!-- Reminder date -->
            <TextView
                android:id="@+id/tvReminderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19/05/2026"
                android:textSize="14sp"
                android:textColor="#4c1d95"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toTopOf="@id/tvReminderEvent"
                app:layout_constraintBottom_toBottomOf="@id/tvReminderEvent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>