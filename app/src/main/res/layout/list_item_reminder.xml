<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvReminderEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Event Name Placeholder"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#1E293B"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvReminderDate"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvReminderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19/05/2026"
            android:textSize="14sp"
            android:textColor="#64748B"
            app:layout_constraintTop_toTopOf="@id/tvReminderEvent"
            app:layout_constraintBottom_toBottomOf="@id/tvReminderEvent"
            app:layout_constraintEnd_toStartOf="@id/ivDeleteReminder"
            android:layout_marginEnd="16dp" />

        <ImageView
            android:id="@+id/ivDeleteReminder"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Delete Reminder"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#EF4444"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>