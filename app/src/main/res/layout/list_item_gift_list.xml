<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivFolderIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_archive"
            android:background="#F1F5F9"
            android:padding="8dp"
            app:tint="#2b4287" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvListName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Όνομα Λίστας"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#1E293B" />

            <TextView
                android:id="@+id/tvGiftCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 δώρα αποθηκευμένα"
                android:textColor="#64748B"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/abc_ic_ab_back_material"
            android:rotation="180"
            app:tint="#CBD5E1" />

    </LinearLayout>
</androidx.cardview.widget.CardView>