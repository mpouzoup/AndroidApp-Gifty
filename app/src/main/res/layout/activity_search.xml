<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1F">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvSearchTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Gift Finder"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tell us more about your loved one"
                android:textColor="#A0A0AB"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSearchTitle" />

            <EditText
                android:id="@+id/etRecipientAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="12dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Age"
                android:inputType="number"
                android:padding="16dp"
                android:textColor="#070000"
                android:textColorHint="#888888"
                app:layout_constraintEnd_toStartOf="@+id/etMaxBudget"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

            <EditText
                android:id="@+id/etMaxBudget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:drawable/editbox_background"
                android:hint="Max Budget (€)"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:textColor="#050000"
                android:textColorHint="#888888"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/etRecipientAge"
                app:layout_constraintTop_toTopOf="@id/etRecipientAge" />

            <TextView
                android:id="@+id/tvRelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relationship"
                android:layout_marginTop="20dp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/etRecipientAge"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spRelationship"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/btn_dropdown"
                app:layout_constraintTop_toBottomOf="@id/tvRelLabel" />

            <TextView
                android:id="@+id/tvOccasionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Occasion"
                android:layout_marginTop="20dp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/spRelationship"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spOccasion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/btn_dropdown"
                app:layout_constraintTop_toBottomOf="@id/tvOccasionLabel" />

            <TextView
                android:id="@+id/tvInterestsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Interests &amp; Hobbies"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/spOccasion" />

            <HorizontalScrollView
                android:id="@+id/svChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvInterestsLabel">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgInterests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGaming"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gaming"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCooking"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cooking"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFitness"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fitness"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReading"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reading"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTech"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tech"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMusic"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Music"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGym"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gym"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTraveling"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Traveling"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCoffee"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coffee"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMovies"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Movies"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLegos"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Legos"
                        android:textColor="#FFFFFF"
                        android:checkable="true" app:chipBackgroundColor="#2D2D34" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnFindGifts"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#8B5CF6"
                android:text="Let's go!"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/svChips"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>