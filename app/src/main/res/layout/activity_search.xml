<?xml version="1.0" encoding="utf-8"?>

<!-- Main root layout for the Gift Results screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1F"
    android:paddingTop="28dp">

    <!-- Top bar container holding navigation and active filters -->
    <LinearLayout
        android:id="@+id/topBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B1B1F"
        android:orientation="vertical"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Back navigation button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back"
                android:src="@drawable/baseline_arrow_back_ios_24" app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#8B5CF6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Perfect Matches"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <!-- Displays the number of gift suggestions found -->
                <TextView
                    android:id="@+id/tvResultsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Found 0 ideas"
                    android:textColor="#A0A0AB"
                    android:textSize="14sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Horizontal scrolling area for active search filters -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <!-- Chip group containing active filter chips -->
            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <!-- Active age filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActiveAge"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age: 34"
                    app:chipBackgroundColor="#2D2D34"
                    android:textColor="#FFFFFF"
                    app:chipMinHeight="32dp"/>

                <!-- Active budget filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActiveBudget"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Under 50.0€"
                    app:chipBackgroundColor="#2D2D34"
                    android:textColor="#FFFFFF"
                    app:chipMinHeight="32dp"/>

                <!-- Active interest/category filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActiveInterest"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Art"
                    app:chipBackgroundColor="#3F3F46"
                    android:textColor="#8B5CF6"
                    app:chipMinHeight="32dp"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- RecyclerView displaying the list of gift suggestions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="12dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBarContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:listitem="@layout/list_item_gift" />

</androidx.constraintlayout.widget.ConstraintLayout>